<Project>
  <!-- RimWorld 1.7 loads Harmony 3; compile against that same API. -->
  <ItemGroup Condition="'$(RimWorld17)' == 'true'">
    <PackageReference Update="Lib.Harmony" Version="3.0.0-rc.3" />
  </ItemGroup>
  <!-- Opt in explicitly; the upstream 1.6 build remains available. -->
  <PropertyGroup Condition="'$(RimWorld17)' == 'true' and ('$(MSBuildProjectName)' == 'Multiplayer' or '$(MSBuildProjectName)' == 'MultiplayerLoader' or '$(MSBuildProjectName)' == 'Common')">
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <!-- The mod's post-build copy needs package dependencies in the output folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup Condition="'$(RimWorld17)' == 'true' and ('$(MSBuildProjectName)' == 'Multiplayer' or '$(MSBuildProjectName)' == 'MultiplayerLoader' or '$(MSBuildProjectName)' == 'Common')">
    <Using Include="HarmonyLib.MethodInvoker" Alias="MethodInvoker" />
    <!-- Use the version-matched reference assemblies from NuGet, not a local game install. -->
    <PackageReference Update="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" PrivateAssets="all" />
  </ItemGroup>
</Project>
