<Project>
  <PropertyGroup>
    <!-- Client.csproj is named Multiplayer; map project names explicitly to source roots. -->
    <_RimWorldVersionSourceDirectory Condition="'$(MSBuildProjectName)' == 'Multiplayer'">Client</_RimWorldVersionSourceDirectory>
    <_RimWorldVersionSourceDirectory Condition="'$(MSBuildProjectName)' == 'MultiplayerLoader'">MultiplayerLoader</_RimWorldVersionSourceDirectory>
    <_RimWorldVersionSourcePath Condition="'$(_RimWorldVersionSourceDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(RimWorldVersion)/$(_RimWorldVersionSourceDirectory)'))/</_RimWorldVersionSourcePath>
    <PathMap Condition="'$(_RimWorldVersionSourceDirectory)' != ''">$(PathMap),$(_RimWorldVersionSourcePath)=Versions/$(RimWorldVersion)/$(_RimWorldVersionSourceDirectory)/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <!-- Version-specific implementations live under Source/1.6 or Source/1.7. -->
    <Compile Remove="Versions/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)$(RimWorldVersion)/$(_RimWorldVersionSourceDirectory)/**/*.cs"
             Condition="'$(_RimWorldVersionSourceDirectory)' != ''">
      <Link>Versions/$(RimWorldVersion)/$(_RimWorldVersionSourceDirectory)/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
</Project>
