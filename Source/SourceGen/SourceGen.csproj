<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.13.0, not 5.3.0: an analyzer referencing a newer Roslyn than the running
         compiler is silently skipped (CS9057) and the generated partials go missing
         (CS8795). SDK 9.x bundles Roslyn 4.14, so 5.3.0 broke every SDK-9 build
         (rwmt #970); newer compilers load the older reference fine. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.13.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatCommandContracts\ChatCommandContracts.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
